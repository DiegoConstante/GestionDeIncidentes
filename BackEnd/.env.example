# URL de conexión a PostgreSQL (Render).
# - En local: usar la URL EXTERNA e incluir ?sslmode=require
# - En Render (producción): usar la Internal Database URL
# - Operaciones de la aplicación (CRUD): usar el usuario con permisos limitados
# - Migraciones (DDL): usar el usuario administrador, pasando su URL solo al ejecutarlas
DATABASE_URL="postgresql://usuario:clave@HOST/nombre_db?sslmode=require"

# Configuración del servidor
PORT=3000
NODE_ENV=development
APP_VERSION=local

# Autenticación JWT
JWT_SECRET=tu_clave_secreta_super_segura
JWT_EXPIRES_IN=30m

# CORS / Cliente Origin = URL de la aplicación
# Origen del frontend: solo dominio, sin ruta ni barra final.
# Local: http://localhost:5173 | Producción: https://usuario.github.io
CLIENT_ORIGIN=http://localhost:5173