# Configuración de producción en Render.
# Usar la URL INTERNA de PostgreSQL y el usuario con permisos solo de CRUD.
# No incluir aquí valores reales; configurar el valor secreto en Render.
DATABASE_URL=

NODE_ENV=production
APP_VERSION=1.0.0
# Render proporciona PORT; no es necesario fijarlo manualmente.
PORT=

# Generar una clave nueva, larga y distinta de la usada en desarrollo.
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Origen exacto del frontend publicado: esquema y dominio, sin ruta ni barra final.
CLIENT_ORIGIN=
