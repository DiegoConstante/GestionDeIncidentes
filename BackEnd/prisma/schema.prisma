generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Estado {
  ABIERTO
  EN_PROCESO
  CERRADO
}

enum Rol {
  ADMIN
  ANALISTA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  correo       String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  rol          Rol      @default(ANALISTA)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Incidente {
  id          Int       @id @default(autoincrement())
  titulo      String    @db.VarChar(120)
  descripcion String    @db.Text
  responsable String    @db.VarChar(100)
  prioridad   Prioridad @default(MEDIA)
  estado      Estado    @default(ABIERTO)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([estado])
  @@index([prioridad])
}